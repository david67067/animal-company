# Environment variables
# Copy this file to .env and update with your values

# Server Configuration
PORT=3000
NODE_ENV=development

# JWT Secrets (Generate random strings for production)
# You can generate secrets using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ACCESS_TOKEN_SECRET=your-access-token-secret-key-here
REFRESH_TOKEN_SECRET=your-refresh-token-secret-key-here
